                "PYTHONIOENCODING": "utf-8"
            },
            "justMyCode": true
        },
        {
            "name": "Rebuild index.html (rebuild_index.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rebuild_index.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            },
            "justMyCode": true
        },
        {
            "name": "Health Check (check_health.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/check_health.py",
            "console": "integratedTerminal",
